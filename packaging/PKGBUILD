# PKGBUILD per Charon — genera un pacchetto Arch .pkg.tar.zst.
# Pensato per la CI: la versione viene iniettata da release.yml (sed su pkgver).
# Compila dal sorgente gia' presente nel repo e impacchetta il binario.
pkgname=charon
pkgver=0.2.1
pkgrel=1
pkgdesc="Dump, import e clonazione di database: PostgreSQL, Oracle, SQL Server (Rust + Tauri + Svelte)"
arch=('x86_64')
url="https://github.com/russus87/charon"
license=('MIT')
# Dipendenze a runtime: webkit per la finestra Tauri, gtk3 per la UI nativa.
depends=('webkit2gtk-4.1' 'gtk3')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
optdepends=(
    'postgresql-libs: tool nativi pg_dump/psql per PostgreSQL'
    'mssql-tools: sqlcmd/bcp per SQL Server'
    'oracle-instantclient-basic: driver Oracle a runtime (migrazione client-side)'
    'oracle-instantclient-tools: expdp/impdp per Oracle Data Pump (opzionale)'
)
options=('!strip' '!lto')

# Il PKGBUILD sta in packaging/, quindi la root del repo e' la cartella superiore.
_repo() { echo "$startdir/.."; }

build() {
    cd "$(_repo)"
    npm install
    # Si compila con la CLI di Tauri (modalita' produzione, frontend incorporato).
    # --no-bundle: niente installer, il pacchetto lo fa makepkg.
    # --features oracle: include il driver Oracle (Instant Client serve solo a runtime).
    npm run tauri build -- --no-bundle --features oracle
}

package() {
    cd "$(_repo)"
    # In un workspace Cargo il binario finisce in target/ alla root del repo.
    # Il binario dell'app desktop è "charon-desktop" (vedi mainBinaryName);
    # lo installiamo come comando "charon".
    install -Dm755 "target/release/charon-desktop" "$pkgdir/usr/bin/charon"
    # Instant Client impacchettato (se la CI l'ha scaricato in resources/oracle):
    # va nella resource dir attesa a runtime da Charon (/usr/lib/charon/...).
    if [ -f "src-tauri/resources/oracle/instantclient.zip" ]; then
        install -Dm644 "src-tauri/resources/oracle/instantclient.zip" \
            "$pkgdir/usr/lib/charon/resources/oracle/instantclient.zip"
    fi
    install -Dm644 "packaging/charon.desktop" \
        "$pkgdir/usr/share/applications/charon.desktop"
    install -Dm644 "src-tauri/icons/128x128.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/charon.png"
    install -Dm644 "src-tauri/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/charon.png"
}
